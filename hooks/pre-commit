#!/bin/sh
# Block a commit whose changed lines trip the gate.
#
# Install it either way:
#   cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#   # or, versioned and shared:
#   git config core.hooksPath hooks
#
# It is diff-scoped on purpose. A whole-tree gate on a repository with legacy
# debt is red from the first run and stays red, so people learn to pass
# --no-verify. -diff reports only what this commit adds, which means the gate is
# green on day one and can only ratchet.
#
# Exit codes: 0 lets the commit through, anything else blocks it. See
# docs/workflow.md for why the two "cannot check" paths below exit 0.
set -u

bin=${METRICGATE:-metricgate}
if ! command -v "$bin" >/dev/null 2>&1; then
    # Fall back to the repo-root binary this repository dogfoods with, so a
    # fresh clone with core.hooksPath=hooks is gated without any PATH setup.
    # Fall-forward keeps the explicit override: a binary that exists but is
    # not executable must still be an error, not a silent skip.
    if [ -x "$PWD/metricgate" ]; then
        bin=$PWD/metricgate
    else
        echo "pre-commit: $bin not found; skipping the gate. Set METRICGATE to its path." >&2
        exit 0
    fi
fi

# A repository with no commits yet has no base to diff against. metricgate says
# so explicitly rather than failing silently, but the first commit is not worth
# blocking on either way.
if ! git rev-parse --verify --quiet HEAD >/dev/null; then
    echo "pre-commit: no commits yet; skipping the diff-scoped gate" >&2
    exit 0
fi

# The architecture-shape gate needs a blessed snapshot (arch snapshot). No
# snapshot file, no arch gate — a documented degradation (the line below says
# so), never a silent one.
archflags=""
if [ -f "$PWD/arch.json" ]; then
    archflags="-arch-base $PWD/arch.json"
else
    echo "pre-commit: no arch.json at repo root; arch-drift gate inactive (run 'metricgate arch snapshot' to bless one)" >&2
fi

exec "$bin" check . -diff $archflags
